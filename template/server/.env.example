# Server environment variables
# Copy this file to .env and fill in actual values

# App
NODE_ENV=development
PORT=3001

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/forge_template

# JWT Authentication
JWT_SECRET=generate-a-secure-random-string-here
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=generate-another-secure-random-string-here
REFRESH_TOKEN_EXPIRY=7d

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug

# Optional: Email (disabled by default)
# Set ENABLE_EMAIL=true and provide a SendGrid API key to enable.
# When disabled, all email functions are silent no-ops.
ENABLE_EMAIL=false
SENDGRID_API_KEY=
EMAIL_FROM=noreply@example.com

# Optional: File uploads (disabled by default)
# Set ENABLE_UPLOADS=true to enable. In development, files are stored locally
# in server/uploads/. In production, files are uploaded to Azure Blob Storage.
ENABLE_UPLOADS=false
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=uploads
